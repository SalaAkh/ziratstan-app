{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.env*",
      "**/.runtimeconfig.json",
      "**/serviceAccount*.json",
      "**/*firebase*adminsdk*.json",
      "**/*-service-account*.json",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "*.py",
      "*.md",
      "*.json",
      "!public/data/**/*.json",
      "src/app/**",
      "src/components/**",
      "src/hooks/**",
      "src/lib/**",
      "src/utils/**",
      "functions/**",
      "supabase/**",
      "testsprite_tests/**",
      "ziratstan-app/**",
      "guids/**",
      "scripts/**",
      "resources/**"
    ]
  }
}
