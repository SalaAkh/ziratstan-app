{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' https: data:; connect-src 'self' https://*.supabase.co https://*.supabase.in https://www.google-analytics.com https://cdn.jsdelivr.net"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".git/**",
      ".next/**",
      ".firebase/**",
      ".vscode/**",
      "**/.*",
      "**/.env*",
      "**/.runtimeconfig.json",
      ".firebase-config/**",
      "**/.firebase-config/**",
      "**/serviceAccount*.json",
      "**/*firebase*adminsdk*.json",
      "**/*-service-account*.json",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "*.py",
      "**/*.ts",
      "**/*.tsx",
      "*.md",
      "*.json",
      "!public/data/**/*.json",
      "src/app/**",
      "src/components/**",
      "src/hooks/**",
      "src/lib/**",
      "src/utils/**",
      "!src/js/**",
      "functions/**",
      "supabase/**",
      "testsprite_tests/**",
      "ziratstan-app/**",
      "guids/**",
      "scripts/**",
      "resources/**"
    ]
  }
}
