{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.env*",
      "**/.runtimeconfig.json",
      "**/serviceAccount*.json",
      "**/*firebase*adminsdk*.json",
      "**/*-service-account*.json",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "*.py",
      "*.md",
      "*.json",
      "!public/data/**/*.json",
      "src/**",
      "functions/**",
      "supabase/**",
      "testsprite_tests/**",
      "ziratstan-app/**",
      "guids/**",
      "scripts/**",
      "resources/**"
    ]
  }
}
